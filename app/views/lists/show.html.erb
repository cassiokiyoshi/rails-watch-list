<%
  movies = @list.movies.sample(10)
  images = movies.map(&:poster_url).compact

  if @list.photo.attached?
    images.unshift(cl_image_path(@list.photo.key))
  end

  if images.empty?
    images << asset_path("defaultbgcinema.jpg")
  end

  duration = images.size * 5
%>

<div class="banner">
  <% images.each_with_index do |image, index| %>
    <div
      class="<%= images.size > 1 ? "banner-bg" : "banner-bg-no-animation" %>"
      style="
        background-image: url('<%= image %>');
        animation-duration: <%= duration %>s;
        animation-delay: <%= index * 5 %>s;
      ">
    </div>
  <% end %>

  <div class="container">
    <h1><%= @list.name %></h1>
  </div>
</div>


<div class="container" data-controller="bookmark">

  <div class="d-flex align-items-center justify-content-around m-2 p-2">
    <h1>Movies</h1>

    <div class="d-flex flex-column">
      <button
        type="button"
        class="btn btn-dark rounded-pill m-1 px-4"
        data-bs-toggle="modal"
        data-bs-target="#addMovieModal">
        + Add movie
      </button>

      <%= render "components/modal_search" %>
    </div>
  </div>


  <div class="cards m-5">
    <% @list.bookmarks.each do |bookmark| %>
      <% movie = bookmark.movie %>

      <div class="card-trip category">

        <img src="<%= movie.poster_url %>" />

        <div class="card-trip-infos">
          <div>
            <h2><%= movie.title %></h2>
            <p><%= movie.overview %></p>
          </div>

          <h2 class="card-trip-pricing">
            <%= format("%.1f", movie.rating) %>
          </h2>

          <%= link_to bookmark_path(bookmark),
                class: "mx-1 text-decoration-none text-black",
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Remove this movie from the list?"
                } do %>

            <i class="fa-solid fa-trash-can"></i>

          <% end %>
        </div>
      </div>

    <% end %>
  </div>

</div>


<div data-controller="movie">
</div>
