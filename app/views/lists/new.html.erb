<div class="banner">
  <div
    class="banner-bg-no-animation"
    style="background-image:
      linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)),
      url('<%= asset_path("defaultbgcinema.jpg") %>');">
  </div>
</div>
<div class="container my-5">
  <h1>Create a new movie list</h1>
  <!--
  <form action="<%#= restaurants_path %>" method="post">
  </form>
  -->
  <%#= form_with model: @restaurant %>
  <%# Simple: adds the action, method, authenticity token %>
  <%= simple_form_for @list do |f| %>
  <%= f.input :name %>
  <%= f.input :photo, as: :file %>
  <%= f.submit "Submit", class: 'btn btn-dark rounded-pill mt-2' %>
  <% end %>
</div>
