<%
  images = [
    "americanhistoryx.webp",
    "getout.jpg",
    "interstellar.jpg",
    "intothewild.jpeg",
    "martyrs.jpeg"
  ]

  duration = images.size * 5
%>

<div class="banner">

  <% images.each_with_index do |image, index| %>
    <div
      class="banner-bg"
      style="
        background-image:
          linear-gradient(rgba(0,0,0,0.4), rgba(0,0,0,0.4)),
          url('<%= asset_path(image) %>');
        animation-duration: <%= duration %>s;
        animation-delay: <%= index * 5 %>s;
      ">
    </div>
  <% end %>

  <div class="container">
    <h1>Make your own movie list!</h1>
  </div>

</div>
